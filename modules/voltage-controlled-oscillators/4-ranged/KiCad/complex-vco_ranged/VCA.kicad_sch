	)
	(text "If you want flat level across the whole rotation, \nchange R95 from 10K to ~35K (E12: 33K). \nThat makes the extreme positions land at \ngain −1.75 and the center at −0.5, but really \nwhat matters is they all stay within ~−6dB \nof each other instead of varying by 11dB."
		(exclude_from_sim no)
		(at 356.616 131.064 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
